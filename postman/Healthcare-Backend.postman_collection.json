                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"mapping_id\", pm.response.json().id);",
                  "pm.test(\"embeds patient and doctor\", () => {",
