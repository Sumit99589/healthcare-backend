# Copy to .env and adjust. Never commit the real .env file.

# --- Django ---
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TIME_ZONE=UTC

# --- PostgreSQL ---
# Either set DATABASE_URL (e.g. from Neon: postgresql://user:pass@host/db?sslmode=require)
# or the individual DB_* values below. DATABASE_URL wins when both are set.
DATABASE_URL=
DB_NAME=healthcare
DB_USER=healthcare
DB_PASSWORD=healthcare
DB_HOST=localhost
DB_PORT=5432

# --- JWT ---
# Defaults to DJANGO_SECRET_KEY when unset.
JWT_SIGNING_KEY=
JWT_ACCESS_TOKEN_MINUTES=30
JWT_REFRESH_TOKEN_DAYS=7

# --- Rate limits ---
THROTTLE_ANON=60/min
THROTTLE_USER=600/min
THROTTLE_AUTH=10/min

# --- CORS (comma-separated origins allowed to call the API from a browser) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000

LOG_LEVEL=INFO
